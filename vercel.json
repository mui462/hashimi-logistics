{
  "framework": null,
  "installCommand": "npm --prefix backend install && npm --prefix frontend install --include=dev",
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "backend/**"
    }
  },
  "crons": [
    { "path": "/api/v1/internal/deliveries/run", "schedule": "0 6 * * *" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.hashimilogistics.com" }],
      "destination": "https://hashimilogistics.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/sitemap.xml", "destination": "/api" },
    { "source": "/robots.txt", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
