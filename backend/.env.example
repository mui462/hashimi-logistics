# Runtime
NODE_ENV=development
PORT=5000

# Database (never commit a real connection string)
MONGO_URI=

# Authentication (JWT_SECRET must be a random string of 32+ characters)
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=hashimi_token
# "lax" (default) or "strict". "none" is rejected at startup until CSRF token protection is built.
COOKIE_SAME_SITE=lax

# Rate limiting (per client IP). Raise the auth limits if automated tests hit them.
GLOBAL_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
# Failed sign-ins allowed per email address inside the window, regardless of IP.
LOGIN_ACCOUNT_LIMIT_MAX=10

# One-time link lifetimes
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24

# Development only: while email delivery is not configured, print password reset and
# email verification links in the server log. Refused when NODE_ENV=production.
DEV_LOG_AUTH_LINKS=false

# Frontend origin allowed by CORS (no trailing path)
CLIENT_URL=http://localhost:5173

# File storage (Phase 10). Leave empty and uploads answer 501 STORAGE_NOT_CONFIGURED.
# Set all three CLOUDINARY_* values (STORAGE_PROVIDER=cloudinary is then implied). `local` is development only.
STORAGE_PROVIDER=
STORAGE_LOCAL_DIR=storage-data
API_PUBLIC_URL=
STORAGE_SIGNED_URL_TTL_SECONDS=300
UPLOAD_IMAGE_MAX_MB=10
UPLOAD_VIDEO_MAX_MB=200
UPLOAD_DOCUMENT_MAX_MB=25
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Notification delivery (Phase 11). Run the worker separately: `npm run worker` (see docs/NOTIFICATIONS_AND_MESSAGING.md).
# EMAIL_PROVIDER: "resend" (real) or "mock" (development/tests, sends nothing; refused in production). Empty = no email is sent.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Only needed when EMAIL_PROVIDER=resend:
RESEND_API_KEY=
# SMS is optional and never required. SMS_PROVIDER: "twilio" (real) or "mock". Empty = no SMS is sent.
SMS_PROVIDER=
# Only needed when SMS_PROVIDER=twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Hosts without a long-running worker (Vercel): a scheduler calls /api/v1/internal/deliveries/run with this secret
# (32+ random characters; also set it as the CRON_SECRET repository secret in GitHub). Empty = endpoint disabled.
CRON_SECRET=
# Retry policy and worker tuning
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_BACKOFF_BASE_SECONDS=60
DELIVERY_BACKOFF_MAX_SECONDS=3600
DELIVERY_WORKER_POLL_SECONDS=10
DELIVERY_BATCH_SIZE=20
DELIVERY_LOCK_SECONDS=120
# Per signed-in user, per 15 minutes, on notification and preference endpoints
NOTIFICATION_RATE_LIMIT_MAX=60

# Phase 12: per-admin limit on finance write endpoints (create, issue, void, record payment, reverse) per 15 minutes.
FINANCE_RATE_LIMIT_MAX=300

# Phase 13 hardening.
# Max forgot-password requests per target e-mail address per hour, and resend-verification requests per user per hour.
RESET_EMAIL_LIMIT_MAX=5
# Max file uploads per signed-in user per hour; max quote requests per client IP per hour.
UPLOAD_RATE_LIMIT_MAX=60
QUOTE_IP_LIMIT_MAX=60
# Public website forms (guest quote, carrier application, contact): max submissions per client IP per hour, per form.
PUBLIC_FORM_LIMIT_MAX=10
# Public shipment tracking: max look-ups per client IP per 15 minutes (found or not).
TRACKING_LIMIT_MAX=30
# Number of reverse proxies / load balancers in front of the API in production (affects req.ip, rate limits, audit IPs).
TRUST_PROXY_HOPS=1
# Production refuses plain-HTTP API requests by default (health checks exempt). Leave unset in production.
# ENFORCE_HTTPS=true

# Used only by `npm run seed:super-admin`. Remove after seeding.
SUPER_ADMIN_FIRST_NAME=hashimi
SUPER_ADMIN_LAST_NAME=logistics
SUPER_ADMIN_EMAIL=hashmilogistic@gmail.com
SUPER_ADMIN_PASSWORD=123456

# Chatbot engine: ollama (default, a model you host) or claude (Anthropic API; set ANTHROPIC_API_KEY, kept on this server only).
# openai = any OpenAI-compatible API, incl. FREE tiers of Groq / Google Gemini / OpenRouter (see docs/AI_ASSISTANT.md).
CHATBOT_PROVIDER=ollama
CHAT_API_BASE_URL=
CHAT_API_KEY=
CHAT_API_MODEL=
CHAT_API_TIMEOUT_MS=30000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_TIMEOUT_MS=30000

# AI assistant (public website chatbot), answered by Ollama (https://ollama.com). See docs/AI_ASSISTANT.md for setup.
# Only this server talks to Ollama; the browser never does. 127.0.0.1 means the machine the BACKEND runs on.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# A model you have downloaded with:  ollama pull qwen2.5:3b   (check with:  ollama list)
OLLAMA_MODEL=qwen2.5:3b
# Optional: a secret your reverse proxy in front of Ollama expects as a Bearer token (leave empty for a local Ollama).
OLLAMA_API_KEY=
# Generation limits. The first answer after the model was idle loads it into memory and can take longer.
OLLAMA_TIMEOUT_MS=120000
OLLAMA_NUM_CTX=4096
OLLAMA_MAX_TOKENS=400
OLLAMA_TEMPERATURE=0.2
OLLAMA_KEEP_ALIVE=30m
# How many website facts are given to the model per question, and how many answers may wait at once.
CHATBOT_CONTEXT_CHUNKS=3
CHATBOT_MAX_PENDING=4
# Per client IP: messages per 10 minutes, and per day.
CHATBOT_RATE_LIMIT_MAX=20
CHATBOT_DAILY_LIMIT_MAX=150
