import { env } from '../config/env.js';
import { ApiError } from '../utils/ApiError.js';
import { ALLOWED_TYPES } from './fileTypes.js';
import { storage } from './index.js';
import { storageNotConfigured } from './storageError.js';

const MB = 1024 * 1024;

const limitFor = (kind) => (kind === 'video' ? env.UPLOAD_VIDEO_MAX_MB : kind === 'image' ? env.UPLOAD_IMAGE_MAX_MB : env.UPLOAD_DOCUMENT_MAX_MB) * MB;

/**
 * Reads ONE file sent as the raw request body (Content-Type = the file's type; the file name travels in the query string).
 * No multipart parser, no extra dependency, exactly one file by construction. Order of checks:
 *   1. the declared type must be allowed for this purpose            -> 415 before a byte is read
 *   2. Content-Length (when sent) must fit the limit for that kind   -> 413 before a byte is read
 *   3. the stream is counted while reading and abandoned at the limit -> 413
 * Content validation (extension and file signature) happens afterwards in inspectFile().
 * Sets req.upload = { buffer, declaredType, size }.
 */
export const readUpload = (purpose) => async (req, res, next) => {
  const declaredType = String(req.headers['content-type'] ?? '').split(';')[0].trim().toLowerCase();
  const rule = ALLOWED_TYPES[purpose][declaredType];
  if (!rule) throw new ApiError(415, 'That file type is not supported.', [], 'UNSUPPORTED_FILE_TYPE');
  const limit = limitFor(rule.kind);
  const tooLarge = () => new ApiError(413, `That file is too large. The limit for this kind of file is ${Math.round(limit / MB)} MB.`, [], 'FILE_TOO_LARGE');
  
  const declaredLength = Number(req.headers['content-length']);

  const chunks = [];
  let size = 0;
  let oversized = Number.isFinite(declaredLength) && declaredLength > limit;

  try {
    for await (const chunk of req) {
      size += chunk.length;

      if (size > limit) {
        oversized = true;
      }

      // Store data only while the complete upload remains within the limit.
      if (!oversized) {
        chunks.push(chunk);
      }
    }
  } catch (error) {
    if (error instanceof ApiError) throw error;

    throw new ApiError(
      400,
      'The upload was interrupted. Please try again.',
      [],
      'UPLOAD_INTERRUPTED'
    );
  }

  if (oversized) {
    throw tooLarge();
  }

  if (size === 0) {
    throw new ApiError(
      400,
      'The uploaded file is empty.',
      [],
      'EMPTY_FILE'
    );
  }
}